{
  "name": "@sap/cds-dpi",
  "version": "1.0.0",
  "description": "CDS plugin providing integration to the SAP Data Privacy Integration service for PII data retention and information retrieval based on annotations.",
  "repository": "cap-js/data-privacy",
  "author": "SAP SE (https://www.sap.com)",
  "main": "cds-plugin.js",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "cds",
    "CAP",
    "cdsbuild"
  ],
  "files": [
    "_i18n",
    "lib",
    "srv",
    "db",
    "index.cds",
    "cds-plugin.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@cap-js/audit-logging": "^1.1.0",
    "patch-package": "^8.0.1"
  },
  "peerDependencies": {
    "@sap/cds": ">=9"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-common-content": "*",
    "@sap/cds-dk": "^9",
    "eslint": "^9",
    "jest": "^29"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "npx eslint .",
    "prettier": "npx -y prettier@3 --write .",
    "prettier:check": "npx -y prettier@3 --check .",
    "test-setup": "npm run setupBookshopTest && npm run setupExtendDPIBookshop && npm run setupExtendInformationBookshop",
    "setupBookshopTest": "cd ./tests/bookshop-app && rm -rf package-lock.json && rm -rf ./node_modules/ && npm link ../../ && npm i && rm -rf ./node_modules/@sap/cds",
    "setupExtendDPIBookshop": "cd ./tests/retention/extend-retention-endpoint && npm i && rm -rf ./node_modules/@sap/cds",
    "setupExtendInformationBookshop": "cd ./tests/information/extend-information-endpoint && npm i && rm -rf ./node_modules/@sap/cds",
    "test": "npx jest --silent",
    "postinstall": "patch-package"
  },
  "cds": {
    "requires": {
      "sap.ilm.RetentionService": {
        "kind": "TableHeaderBlocking",
        "tableRestrictions": "srv"
      },
      "sap.ilm.InformationService": {
        "model": "@sap/cds-dpi/srv/DPIInformation"
      },
      "kinds": {
        "sap.ilm.RetentionService-TableHeaderBlocking": {
          "impl": "@sap/cds-dpi/srv/TableHeaderBlocking",
          "model": "@sap/cds-dpi/srv/TableHeaderBlocking"
        }
      }
    }
  }
}
