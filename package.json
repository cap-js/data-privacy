{
  "name": "@sap/cds-dpi",
  "version": "0.5.2",
  "description": "CDS plugin providing integration to the SAP Data Privacy Integration service for PII data retention and information retrieval based on annotations.",
  "repository": "cap-js/data-privacy",
  "author": "SAP SE (https://www.sap.com)",
  "main": "cds-plugin.js",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "cds",
    "CAP",
    "cdsbuild"
  ],
  "files": [
    "lib",
    "db",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@cap-js/audit-logging": "^1.1.0"
  },
  "peerDependencies": {
    "@sap/cds": ">=9"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-common-content": "*",
    "@sap/cds-dk": "^9",
    "eslint": "^9",
    "jest": "^29"
  },
  "engines": {
    "node": "^20"
  },
  "scripts": {
    "lint": "npx eslint .",
    "test": "npx jest --silent"
  },
  "workspaces": [
    "tests/bookshop-app"
  ],
  "cds": {
    "requires": {
      "data-privacy-retention": {
        "kind": "TableHeader"
      },
      "data-privacy-information": {
        "model": "@sap/cds-dpi/srv/DPIInformation"
      },
      "kinds": {
        "data-privacy-retention-TableHeader": {
          "impl": "@sap/cds-dpi/srv/TableHeaderBlocking",
          "model": "@sap/cds-dpi/srv/TableHeaderBlocking"
        }
      }
    }
  }
}
