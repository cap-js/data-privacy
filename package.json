{
  "name": "@sap/cds-dpi",
  "version": "0.5.2",
  "description": "CDS plugin providing integration to the SAP Data Privacy Integration service for PII data retention and information retrieval based on annotations.",
  "repository": "cap-js/data-privacy",
  "author": "SAP SE (https://www.sap.com)",
  "main": "cds-plugin.js",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "cds",
    "CAP",
    "cdsbuild"
  ],
  "files": [
    "lib",
    "db",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@sap/textbundle": "^4.2.0",
    "dayjs": "^1.11.5",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@sap/cds": ">=8.6",
    "@cap-js/audit-logging": "^1.1.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-common-content": "*",
    "@sap/cds-dk": "^7",
    "@sap/cds-dpi": "file:.",
    "@sap/cds-foss": "*",
    "axios": "^1",
    "eslint": "^9",
    "express": "^4.17.1",
    "jest": "^29",
    "sqlite3": "^5.1.7"
  },
  "engines": {
    "node": "^18.16.0"
  },
  "scripts": {
    "lint": "npx eslint .",
    "test": "npm run test-new-db && npm run test-old-db",
    "test-new-db": "CDS_ENV='better-sqlite' npx jest --silent",
    "test-old-db": "CDS_ENV='legacy-sqlite' npx jest --silent"
  },
  "workspaces": [
    "tests/integration/bookshop-app"
  ],
  "cds": {
    "requires": {
      "data-privacy-retention": {
        "kind": "data-privacy-retention-TableHeader"
      },
      "data-privacy-information": {
        "model": "@sap/cds-dpi/srv/DPIInformation"
      },
      "kinds": {
        "data-privacy-retention-TableHeader": {
          "impl": "@sap/cds-dpi/srv/TableHeaderBlocking",
          "model": "@sap/cds-dpi/srv/TableHeaderBlocking"
        }
      }
    }
  }
}
