{
  "name": "@capire/gdpr",
  "description": "My application",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/audit-logging": "^1.0.0",
    "@cap-js/hana": "^2",
    "@cap-js/telemetry": "^0.2.0",
    "@dynatrace/oneagent-sdk": "^1.5.0",
    "@sap/cds": "^9",
    "@sap/cds-common-content": "^1.0.1",
    "@sap/cds-dpi": "file:../../.",
    "@sap/xsenv": "^3.1.0",
    "@sap/xssec": "^3",
    "express": "^4.17.1",
    "passport": "^0",
    "path": "^0.12.7",
    "serve-static": "^1.15.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@sap/eslint-plugin-cds": "^2.6.0",
    "@sap/ux-specification": "^1.102.15",
    "eslint": "^8.13.0",
    "jest": "^29.5.0"
  },
  "scripts": {
    "start": "cds-serve --production",
    "watch": "cds watch"
  },
  "engines": {
    "node": "^20"
  },
  "cds": {
    "i18n": {
      "drm_folder": "_i18n"
    },
    "requires": {
      "[development]": {
        "auth": {
          "strategy": "dummy",
          "users": {
            "alice": {
              "password": "1234",
              "roles": [
                "PersonalDataManagerUser",
                "DataRetentionManagerUser"
              ]
            }
          }
        }
      },
      "db": {
        "kind": "sql"
      },
      "uaa": {
        "kind": "xsuaa"
      },
      "[production]": {
        "db": {
          "kind": "hana-cloud"
        },
        "auth": "xsuaa"
      }
    },
    "features": {
      "kibana_formatter": true
    },
    "hana": {
      "deploy-format": "hdbtable"
    },
    "log": {
      "levels": {
        "drm": "debug"
      }
    }
  }
}
