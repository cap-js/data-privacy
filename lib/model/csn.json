    "DRMService.dataSubjectsEndOfResidence": {
      "kind": "action",
      "params": {
        "applicationName": {
          "type": "cds.String"
        },
        "iLMObjectName": {
          "type": "cds.String"
        },
        "dataSubjectRoleName": {
          "type": "cds.String"
        },
        "referenceDates": {
          "items": {
            "elements": {
              "referenceDateName": {
                "type": "cds.String"
              },
              "organizationAttributeResidenceSet": {
                "items": {
                  "elements": {
                    "organizationAttributeName": {
                      "type": "cds.String"
                    },
                    "organizationAttributeValue": {
                      "type": "cds.String"
                    },
                    "residenceSet": {
                      "items": {
                        "elements": {
                          "retentionStartDate": {
                            "type": "cds.String"
                          },
                          "conditionSet": {
                            "items": {
                              "type": "Condition"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "returns": {
        "elements": {
          "success": {
            "items": {
              "elements": {
                "dataSubjectId": {
                  "type": "cds.String"
                }
              }
            }
          },
          "nonConfirmCondition": {
            "items": {
              "elements": {
                "dataSubjectId": {
                  "type": "cds.String"
                }
              }
            }
          }
        }
      }
    },
