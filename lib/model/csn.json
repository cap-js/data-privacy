{
  "definitions": {
    "DRMService": {
      "kind": "service",
      "@requires": "DataRetentionManagerUser",
      "@protocol": "rest",
      "@cds.provided": true,
      "@path": "/drm"
    },
    "DRMService.i18n-files": {
      "kind": "entity",
      "elements": {
        "file": {
          "key": true,
          "type": "cds.String"
        }
      }
    },
    "PDMService": {
      "kind": "service",
      "@requires": "PersonalDataManagerUser",
      "@cds.provided": true,
      "@path": "/pdm"
    },
    "DRMService.endOfResidence": {
      "kind": "action",
      "params": {
        "applicationName": {
          "type": "cds.String"
        },
        "iLMObjectName": {
          "type": "cds.String"
        },
        "selectionCriteria": {
          "items": {
            "type": "SelectionCriteria"
          }
        },
        "retentionStartDate": {
          "type": "cds.String"
        },
        "referenceDateName": {
          "type": "cds.String"
        },
        "excludedConditionSets": {
          "items": {
            "elements": {
              "conditionSet": {
                "items": {
                  "elements": {
                    "conditionFieldName": {
                      "type": "cds.String"
                    },
                    "conditionFieldValue": {
                      "type": "cds.String"
                    }
                  }
                }
              }
            }
          }
        },
        "conditionSet": {
          "items": {
            "elements": {
              "conditionFieldName": {
                "type": "cds.String"
              },
              "conditionFieldValue": {
                "type": "cds.String"
              }
            }
          }
        }
      },
      "returns": {
        "elements": {
          "iLMObjectInstancesArchiveCount": {
            "type": "cds.Integer"
          },
          "iLMObjectInstances": {
            "items": {
              "elements": {
                "keys": {
                  "items": {
                    "elements": {
                      "key": {
                        "type": "cds.String"
                      },
                      "value": {
                        "type": "cds.String"
                      }
                    }
                  }
                },
                "retentionStartDate": {
                  "type": "cds.DateTime"
                }
              }
            }
          },
          "deltatoken": {
            "type": "cds.String"
          }
        }
      }
    },
    "DRMService.archive": {
      "kind": "action",
      "params": {
        "applicationName": {
          "type": "cds.String"
        },
        "iLMObjectName": {
          "type": "cds.String"
        },
        "iLMObjectArchiveResidenceRules": {
          "items": {
            "elements": {
              "residenceRuleId": {
                "type": "cds.String"
              },
              "iLMObjectInstances": {
                "items": {
                  "elements": {
                    "retentionStartDate": {
                      "type": "cds.String"
                    },
                    "retentionEndDate": {
                      "type": "cds.String"
                    },
                    "keys": {
                      "items": {
                        "elements": {
                          "key": {
                            "type": "cds.String"
                          },
                          "value": {
                            "type": "cds.String"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "referenceDateName": {
          "type": "cds.String"
        }
      },
      "returns": {
        "elements": {
          "success": {
            "type": "cds.Integer"
          },
          "failure": {
            "type": "cds.Integer"
          }
        }
      }
    },
    "DRMService.destruction": {
      "kind": "action",
      "params": {
        "applicationName": {
          "type": "cds.String"
        },
        "runId": {
          "type": "cds.String"
