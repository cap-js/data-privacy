          }
        },
        "referenceDates": {
          "items": {
            "elements": {
              "referenceDateName": {
                "type": "cds.String"
              },
              "organizationAttributeResidenceSet": {
                "items": {
                  "elements": {
                    "organizationAttributeName": {
                      "type": "cds.String"
                    },
                    "organizationAttributeValue": {
                      "type": "cds.String"
                    },
                    "residenceSet": {
                      "items": {
                        "elements": {
                          "retentionStartDate": {
                            "type": "cds.String"
                          },
                          "conditionSet": {
                            "items": {
                              "type": "Condition"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
